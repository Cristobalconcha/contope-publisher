{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "contope/mapa",
  "version": "0.1.0",
  "title": "Mapa de ubicación",
  "category": "media",
  "icon": "location-alt",
  "description": "Mapa de ubicación con un marcador. Usa la clave pública de Mapbox guardada en Configuración → Mapa (Mapbox), que nunca queda escrita en el contenido. Sin clave, muestra el enlace a «cómo llegar».",
  "keywords": [ "mapa", "ubicacion", "mapbox", "como llegar", "contope" ],
  "textdomain": "contope-publisher",
  "attributes": {
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "zoom": {
      "type": "number",
      "default": 15
    },
    "alto": {
      "type": "integer",
      "default": 400
    },
    "fijo": {
      "type": "boolean",
      "default": true
    },
    "mini": {
      "type": "string",
      "default": ""
    },
    "marcador": {
      "type": "string",
      "default": ""
    },
    "globo": {
      "type": "string",
      "default": ""
    },
    "etiqueta": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [ "wide", "full" ],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true
    },
    "shadow": true,
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
