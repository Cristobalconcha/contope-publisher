{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "contope/formulario",
  "version": "0.1.0",
  "title": "Formulario (Orugantt Forms)",
  "category": "widgets",
  "icon": "feedback",
  "description": "Incrusta un formulario de Orugantt Forms. El diseño no se escribe aquí: el formulario toma las variables que declara el tema.",
  "keywords": [ "formulario", "contacto", "orugantt", "contope" ],
  "textdomain": "contope-publisher",
  "attributes": {
    "formSlug": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [ "wide", "full" ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
