# Copiar como .env.local. Nunca guardar credenciales reales en este archivo.

# Sitio WordPress
OCD_WP_URL=https://example.com
OCD_WP_USERNAME=
OCD_WP_APPLICATION_PASSWORD=

# Transferencia de archivos ofrecida por el hosting.
# Usar TLS explícito cuando el servidor lo admita.
OCD_FTP_HOST=
OCD_FTP_PORT=21
OCD_FTP_USERNAME=
OCD_FTP_PASSWORD=
OCD_FTP_TLS=true
OCD_FTP_PASSIVE=true
OCD_FTP_REMOTE_PATH=/public_html/wp-content/plugins/
