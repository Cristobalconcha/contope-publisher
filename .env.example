# Copiar como .env.local. Nunca guardar credenciales reales en este archivo.

# Sitio WordPress
COD_WP_URL=https://example.com
COD_WP_USERNAME=
COD_WP_APPLICATION_PASSWORD=

# Transferencia de archivos ofrecida por el hosting.
# Usar TLS explícito cuando el servidor lo admita.
COD_FTP_HOST=
COD_FTP_PORT=21
COD_FTP_USERNAME=
COD_FTP_PASSWORD=
COD_FTP_TLS=true
COD_FTP_PASSIVE=true
COD_FTP_REMOTE_PATH=/public_html/wp-content/plugins/
