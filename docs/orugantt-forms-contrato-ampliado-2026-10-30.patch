diff --git a/pruebas/probar-contador-formato.mjs b/pruebas/probar-contador-formato.mjs
new file mode 100644
index 0000000..951e025
--- /dev/null
+++ b/pruebas/probar-contador-formato.mjs
@@ -0,0 +1,21 @@
+/**
+ * El texto del contador de caracteres (contadorFormato de un campo, Orugantt Forms, contrato ampliado del 30-oct-2026).
+ *
+ *   node --experimental-strip-types pruebas/probar-contador-formato.mjs
+ */
+import { textoDelContador } from '../runtime-src/src/contador.ts';
+
+let fallas = 0;
+const c = (caso, obtenido, esperado) => {
+  const ok = obtenido === esperado;
+  if (!ok) fallas++;
+  console.log((ok ? '  ok     ' : '  FALLA  ') + caso + (ok ? '' : `   obtuvo «${obtenido}», esperaba «${esperado}»`));
+};
+c('sin formato: el de siempre', textoDelContador(undefined, 0, 600), '0/600');
+c('formato vacío: el de siempre', textoDelContador('   ', 12, 600), '12/600');
+c('formato que no es texto: el de siempre', textoDelContador(42, 3, 10), '3/10');
+c('«{n} de {max} caracteres máximos»', textoDelContador('{n} de {max} caracteres máximos', 0, 600), '0 de 600 caracteres máximos');
+c('el formato puede repetir o invertir los números', textoDelContador('quedan {max} de {max}; escritos {n}', 5, 20), 'quedan 20 de 20; escritos 5');
+c('un formato sin marcas se deja tal cual', textoDelContador('sin número', 5, 20), 'sin número');
+console.log(fallas === 0 ? '\nTODO OK' : `\n${fallas} FALLARON`);
+process.exit(fallas === 0 ? 0 : 1);
diff --git a/pruebas/probar-contrato-de-diseno.php b/pruebas/probar-contrato-de-diseno.php
new file mode 100644
index 0000000..85e6c8f
--- /dev/null
+++ b/pruebas/probar-contrato-de-diseno.php
@@ -0,0 +1,63 @@
+<?php
+/**
+ * El contrato de diseño del runtime (OFR_Design_Tokens) y su hoja de estilos no se desalinean.
+ *
+ * Contra un WordPress con el plugin activo y el runtime compilado (assets/dist):
+ *
+ *   OFR_WP_LOAD=C:/ruta/wp-load.php php pruebas/probar-contrato-de-diseno.php
+ *   (o: wp eval-file wp-content/plugins/orugantt-forms/pruebas/probar-contrato-de-diseno.php)
+ *
+ * Comprueba que cada variable del contrato: (1) es una variable `--ofr-*` única, (2) la usa la hoja compilada con var(), (3) si es
+ * de tipo `keyword`, declara su lista cerrada de valores, y que las variables de la segunda parte del contrato (30-oct-2026) están.
+ */
+if (!defined('ABSPATH')) {
+    define('WP_USE_THEMES', false);
+    require getenv('OFR_WP_LOAD') ?: dirname(__DIR__, 4) . '/wp-load.php';
+}
+
+$fallas = 0;
+$c = static function (string $caso, bool $ok, string $detalle = '') use (&$fallas): void {
+    echo ($ok ? '  ok     ' : '  FALLA  ') . $caso . (!$ok && $detalle !== '' ? "   $detalle" : '') . "
+";
+    if (!$ok) {
+        $fallas++;
+    }
+};
+
+$tokens = OFR_Design_Tokens::advanced();
+$css = (string) file_get_contents(dirname(__DIR__) . '/assets/dist/orugantt-forms-runtime.css');
+$c('el runtime compilado existe', $css !== '');
+
+$vistos = [];
+$sinUso = [];
+$repetidos = [];
+foreach ($tokens as $clave => $def) {
+    $t = (string) $def['token'];
+    if (isset($vistos[$t]) && $vistos[$t] !== 'surfaceAlt' && $clave !== 'surfaceAlt') {
+        $repetidos[] = $t;
+    }
+    $vistos[$t] = $clave;
+    if (strpos($css, 'var(' . $t) === false) {
+        $sinUso[] = $clave . ' (' . $t . ')';
+    }
+}
+$c('ninguna variable del contrato se repite', $repetidos === [], implode(', ', $repetidos));
+$c('cada variable del contrato la usa la hoja compilada', $sinUso === [], implode(', ', $sinUso));
+
+$sinValores = [];
+foreach ($tokens as $clave => $def) {
+    if ($def['type'] === 'keyword' && (empty($def['values']) || !is_array($def['values']))) {
+        $sinValores[] = $clave;
+    }
+}
+$c('toda variable keyword declara su lista cerrada de valores', $sinValores === [], implode(', ', $sinValores));
+
+foreach (['ayudaRellenoY', 'ayudaSeparacion', 'contadorRellenoY', 'contadorInterlineado', 'contadorAlineacion', 'pieRellenoY', 'pieSeparacion', 'casillaApariencia', 'casillaTamano', 'casillaFondo', 'opcionSangria', 'opcionSeparacion', 'grupoTituloSeparacion', 'etiquetaSeparacion', 'rejillaSeparacion', 'rejillaFilaSeparacion'] as $clave) {
+    $c("el contrato trae $clave", isset($tokens[$clave]));
+}
+$c('contadorAlineacion admite izquierda, derecha y centro', ($tokens['contadorAlineacion']['values'] ?? []) === ['left', 'right', 'center']);
+
+echo "
+" . ($fallas === 0 ? 'TODO OK' : "$fallas FALLARON") . "
+";
+exit($fallas === 0 ? 0 : 1);
