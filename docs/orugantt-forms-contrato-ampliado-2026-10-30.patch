diff --git a/runtime-src/src/contador.ts b/runtime-src/src/contador.ts
new file mode 100644
index 0000000..20e4f28
--- /dev/null
+++ b/runtime-src/src/contador.ts
@@ -0,0 +1,10 @@
+/**
+ * Texto del contador de caracteres de un campo con largo máximo.
+ *
+ * `contadorFormato` (propiedad del campo) lleva `{n}` (los caracteres que hay) y `{max}` (el tope): «{n} de {max} caracteres
+ * máximos». Sin formato, el de siempre: «{n}/{max}». Va en su propio archivo, sin dependencias, para poder probarlo solo.
+ */
+export function textoDelContador(formato: unknown, n: number, max: number): string {
+    const base = typeof formato === 'string' && formato.trim() !== '' ? formato : '{n}/{max}';
+    return base.split('{n}').join(String(n)).split('{max}').join(String(max));
+}
