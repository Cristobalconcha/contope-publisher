  "styles": [
    {
      "_causa": "Pastilla verde de WhatsApp. Longhands a propósito: Grapes descarta las abreviadas al expandirlas y ya nos costó una vez.",
      "selector": ".header-wa",
      "style": {
        "display": "inline-flex",
        "align-items": "center",
        "row-gap": "8px",
        "column-gap": "8px",
        "flex": "0 0 auto",
        "padding-top": "8px",
        "padding-right": "14px",
        "padding-bottom": "8px",
        "padding-left": "14px",
        "border-top-left-radius": "999px",
        "border-top-right-radius": "999px",
        "border-bottom-right-radius": "999px",
        "border-bottom-left-radius": "999px",
        "background-color": "#25D366",
        "color": "#ffffff",
        "font-size": "11.5px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "text-transform": "uppercase",
        "text-decoration-line": "none",
        "line-height": "1",
        "transition-property": "transform, filter",
        "transition-duration": "0.2s",
        "transition-timing-function": "ease"
      }
    },
    {
      "selector": ".header-wa svg",
      "style": {
        "display": "block",
        "flex": "0 0 auto"
      }
    },
    {
      "selector": ".header-wa:hover",
      "style": {
        "filter": "brightness(0.93)",
        "transform": "translateY(-1px)"
      }
    },
    {
      "_causa": "Bajo 720px aparece el botón de menú; el badge se reduce a círculo solo-ícono para que los dos convivan sin apretar el logo.",
      "selector": ".header-wa",
      "media": "(max-width: 720px)",
      "style": {
        "width": "38px",
        "height": "38px",
        "padding-top": "0px",
        "padding-right": "0px",
        "padding-bottom": "0px",
        "padding-left": "0px",
        "justify-content": "center"
      }
    },
    {
      "selector": ".header-wa__texto",
      "media": "(max-width: 720px)",
      "style": {
        "display": "none"
      }
    },
    {
      "_causa": "Se repone COMPLETA (setRule reemplaza la regla): Grapes descartaría background: var(...) por ser abreviada.",
      "selector": ".header-nav__burger span",
      "style": {
        "display": "block",
        "width": "100%",
        "height": "2px",
        "border-top-left-radius": "2px",
        "border-top-right-radius": "2px",
        "border-bottom-right-radius": "2px",
        "border-bottom-left-radius": "2px",
        "background-color": "var(--oliva-700)",
        "transition-property": "transform, opacity",
        "transition-duration": "0.25s, 0.2s",
        "transition-timing-function": "ease, ease",
        "transition-delay": "0s, 0s"
      }
    },
    {
      "_causa": "Desplegable móvil completo. box-shadow va literal: dentro de un @media Grapes lo descarta si lleva var().",
      "selector": ".header-nav__links",
      "media": "(max-width: 720px)",
      "style": {
        "flex-direction": "column",
        "row-gap": "0px",
        "column-gap": "0px",
        "position": "absolute",
        "top": "100%",
        "left": "0px",
        "right": "0px",
        "background-color": "var(--tierra-50)",
        "box-shadow": "0 14px 28px rgba(40,35,20,0.14)",
        "max-height": "0px",
        "overflow-x": "hidden",
        "overflow-y": "hidden",
        "transition-property": "max-height",
        "transition-duration": "0.3s",
        "transition-timing-function": "ease",
        "transition-delay": "0s"
      }
    },
    {
      "_causa": "Enlaces del desplegable móvil, con la línea separadora en forma expandida.",
      "selector": ".header-nav__links a",
      "media": "(max-width: 720px)",
      "style": {
        "display": "block",
        "padding-top": "16px",
        "padding-right": "24px",
        "padding-bottom": "16px",
        "padding-left": "24px",
        "border-bottom-width": "1px",
        "border-bottom-style": "solid",
        "border-bottom-color": "var(--tierra-100)"
      }
    }
  ]
}