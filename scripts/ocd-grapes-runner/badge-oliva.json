{
  "_comentario": "El badge pasa del verde de WhatsApp al oliva oscuro del sitio (--oliva-700), igual que los íconos flotantes de WhatsApp. Se escribe el cuerpo COMPLETO porque setRule reemplaza la regla entera.",
  "mode": "append",
  "structure": [],
  "styles": [
    {
      "selector": ".header-wa",
      "style": {
        "display": "inline-flex",
        "align-items": "center",
        "row-gap": "8px",
        "column-gap": "8px",
        "flex": "0 0 auto",
        "padding-top": "8px", "padding-right": "14px", "padding-bottom": "8px", "padding-left": "14px",
        "border-top-left-radius": "999px", "border-top-right-radius": "999px",
        "border-bottom-right-radius": "999px", "border-bottom-left-radius": "999px",
        "background-color": "var(--oliva-700)",
        "color": "#ffffff",
        "font-size": "11.5px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "text-transform": "uppercase",
        "text-decoration-line": "none",
        "line-height": "1",
        "transition-property": "transform, filter",
        "transition-duration": "0.2s",
        "transition-timing-function": "ease"
      }
    }
  ]
}
