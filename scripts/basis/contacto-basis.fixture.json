          "tipoEntrada": "email",
          "autocompletar": "email",
          "layoutClasses": [
            "col-6"
          ]
        },
        {
          "type": "texto",
          "id": "correo_repite",
          "label": "Repita su email",
          "obligatorio": true,
          "registrarEnDb": false,
          "tipoEntrada": "email",
