          "registrarEnDb": true,
          "autocompletar": "family-name",
          "layoutClasses": [
            "col-6"
          ]
        }
      ]
    },
    {
      "type": "GridSection",
      "id": "fila_correo",
      "titulo": "Email",
      "obligatorio": true,
      "items": [
        {
          "type": "texto",
