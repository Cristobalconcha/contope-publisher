{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ocd/heading",
  "version": "0.1.0",
  "title": "Título OCD",
  "category": "text",
  "icon": "heading",
  "description": "Título con nivel h1-h6 como bloque Gutenberg nativo. POC de la migración gradual a bloques ocd/*.",
  "keywords": [ "título", "titulo", "heading", "encabezado", "ocd" ],
  "textdomain": "open-codesign-publisher",
  "attributes": {
    "content": {
      "type": "string",
      "default": ""
    },
    "level": {
      "type": "integer",
      "default": 2
    },
    "ocdEnhancements": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "anchor": true,
    "className": true
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
